<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%thread] %-5level %logger - %message%newline%exception" />
    </layout>
  </appender>

  <appender name="AppAppender" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogRoot}\\app.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="5MB" />
    <maxSizeRollBackups value="3" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%thread] %-5level %logger - %message%newline%exception" />
    </layout>
  </appender>

  <appender name="QueueAppender" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogRoot}\\queue.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="5MB" />
    <maxSizeRollBackups value="3" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%thread] %-5level %logger - %message%newline%exception" />
    </layout>
  </appender>

  <appender name="LoggingObserverAppender" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogRoot}\\logging-observer.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="5MB" />
    <maxSizeRollBackups value="3" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%thread] %-5level %logger - %message%newline%exception" />
    </layout>
  </appender>

  <appender name="ProfilingObserverAppender" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogRoot}\\profiling-observer.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="5MB" />
    <maxSizeRollBackups value="3" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%thread] %-5level %logger - %message%newline%exception" />
    </layout>
  </appender>

  <logger name="TplQueue.Usage.QueueObserverConsole">
    <level value="ALL" />
    <appender-ref ref="AppAppender" />
  </logger>

  <logger name="Fmacias.TplQueue.Contracts.IParallelQ">
    <level value="ALL" />
    <appender-ref ref="QueueAppender" />
  </logger>

  <logger name="Fmacias.TplQueue.Contracts.ILoggingObserver">
    <level value="ALL" />
    <appender-ref ref="LoggingObserverAppender" />
  </logger>

  <logger name="Fmacias.TplQueue.Contracts.IProfilingObserver">
    <level value="ALL" />
    <appender-ref ref="ProfilingObserverAppender" />
  </logger>

  <root>
    <level value="ALL" />
    <appender-ref ref="ConsoleAppender" />
  </root>
</log4net>
