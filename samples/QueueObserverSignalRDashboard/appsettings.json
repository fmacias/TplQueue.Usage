{
  "TplQueue": {
    "MetadataDispatcherName": "dashboard-metadata",
    "PayloadDispatcherName": "dashboard-payload",
    "RetryPolicies": {
      "dashboard-default": {
        "BaseDelayMs": 200,
        "MaxRetries": 3,
        "Factor": 2.0
      },
      "payload-default": {
        "BaseDelayMs": 150,
        "MaxRetries": 2,
        "Factor": 1.5
      }
    },
    "Dispatchers": {
      "dashboard-metadata": {
        "MaxParallelism": 1,
        "RetryPolicy": "dashboard-default"
      },
      "dashboard-payload": {
        "MaxParallelism": 1,
        "RetryPolicy": "payload-default"
      }
    }
  }
}
