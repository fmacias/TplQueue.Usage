@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IEtlExecutionProjectionStore ProjectionStore

<PageTitle>TplQueue job monitor</PageTitle>
<header class="dashboard-heading"><h1>TplQueue <span>Job monitor</span></h1><span>Passive observer view</span></header>
<section class="monitor-host" aria-label="ETL execution timeline">
    <JobMonitor Snapshot="_snapshot" JobSelected="OnJobSelected" />
</section>
<div class="visually-hidden" aria-live="polite">
    @foreach (var queue in _queues)
    {
        <span data-queue="@queue.GroupId" data-completed="@queue.CompletedCount" data-total="@queue.JobCount">@queue.DisplayName: @queue.CompletedCount of @queue.JobCount completed.</span>
    }
</div>

@code {
    private JobMonitorSnapshot _snapshot = new(Array.Empty<JobMonitorQueue>(), Array.Empty<JobMonitorJob>());
    private IReadOnlyList<EtlQueueSnapshot> _queues = Array.Empty<EtlQueueSnapshot>();
    private Guid? _selectedJobId;
    private volatile bool _disposed;
    private int _refreshPending;

    protected override void OnInitialized()
    {
        ProjectionStore.Changed += OnProjectionChanged;
        Refresh();
    }

    private void Refresh()
    {
        var state = ProjectionStore.GetSnapshot();
        _queues = state.Queues;
        _snapshot = JobMonitorMapper.Map(state);
    }

    private void OnProjectionChanged(object? sender, EventArgs args)
    {
        if (_disposed || Interlocked.Exchange(ref _refreshPending, 1) != 0) return;
        _ = InvokeAsync(() =>
        {
            Interlocked.Exchange(ref _refreshPending, 0);
            if (_disposed) return;
            Refresh();
            StateHasChanged();
        });
    }

    private void OnJobSelected(Guid jobId) => _selectedJobId = jobId;

    public void Dispose()
    {
        _disposed = true;
        ProjectionStore.Changed -= OnProjectionChanged;
    }
}
