@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IJobMonitorStore MonitorStore
@inject ISimulationService Simulation
@inject ILogger<Dashboard> Logger

<PageTitle>TplQueue job monitor</PageTitle>
<header class="dashboard-heading">
    <h1>TplQueue <span>Job monitor</span></h1>
    <div class="simulation-controls">
        <span role="status" data-arrivals-state="@(_arrivalsStopped ? "stopped" : "running")">
            @(_arrivalsStopped ? "Arrivals stopped. Accepted jobs can finish." : "New jobs arrive automatically.")
        </span>
        <button type="button" data-stop-arrivals disabled="@(_stopping || _arrivalsStopped)" @onclick="StopArrivalsAsync">
            @(_stopping ? "Stopping arrivals…" : "Stop arrivals")
        </button>
    </div>
</header>
@if (_snapshot.DroppedEventCount > 0)
{
    <p role="status">Showing retained history. @_snapshot.DroppedEventCount older observations have expired.</p>
}
@if (_stopError != null)
{
    <p role="alert">@_stopError</p>
}
<section class="monitor-host" aria-label="Job execution timeline">
    <JobMonitor Snapshot="_snapshot" JobSelected="OnJobSelected" />
</section>
<div class="visually-hidden" aria-live="polite">
    @foreach (var queue in _queues)
    {
        <span data-queue="@queue.Id" data-completed="@queue.Completed" data-total="@queue.Total">@queue.Name: @queue.Completed of @queue.Total completed.</span>
    }
</div>

@code {
    private JobMonitorSnapshot _snapshot = JobMonitorSnapshot.Empty;
    private IReadOnlyList<(string Id, string Name, int Total, int Completed)> _queues =
        Array.Empty<(string, string, int, int)>();
    private Guid? _selectedJobId;
    private volatile bool _disposed;
    private int _refreshPending;
    private readonly CancellationTokenSource _viewLifetime = new();
    private bool _stopping, _arrivalsStopped;
    private string? _stopError;

    protected override void OnInitialized()
    {
        MonitorStore.Changed += OnObservationsChanged;
        Refresh();
        _arrivalsStopped = Simulation.Completion.IsCompleted;
        _ = ObserveDeliveryCompletionAsync();
    }

    private async Task StopArrivalsAsync()
    {
        if (_stopping || _arrivalsStopped) return;
        _stopping = true;
        _stopError = null;
        try
        {
            await Simulation.StopAsync();
            _arrivalsStopped = true;
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Stopping simulation arrivals failed.");
            _stopError = "Could not stop arrivals. Please try again.";
        }
        finally { _stopping = false; }
    }

    // Completion notifies every connected circuit, including stops requested by another browser.
    private async Task ObserveDeliveryCompletionAsync()
    {
        try
        {
            await Simulation.Completion.WaitAsync(_viewLifetime.Token);
            if (_disposed) return;
            await InvokeAsync(() =>
            {
                if (_disposed) return;
                _arrivalsStopped = true;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception error)
        {
            Logger.LogError(error, "Observing simulation completion failed.");
        }
    }

    private void Refresh()
    {
        _snapshot = MonitorStore.GetSnapshot();
        // Accessible queue totals concern distinct observed jobs, not the number of occurrences.
        _queues = _snapshot.Queues.Select(queue =>
        {
            var jobs = _snapshot.Events.Where(e => e.JobInfo.CrossQueueId == queue.QueueId)
                .GroupBy(e => e.JobInfo.Id).ToArray();
            var completed = jobs.Count(events => events
                .Where(e => e.Status is JobEventStatus.Successed or JobEventStatus.RootSuccessed or
                    JobEventStatus.Failed or JobEventStatus.Canceled)
                .Reverse().OrderByDescending(e => e.Timestamp).FirstOrDefault()?.Status is
                    JobEventStatus.Successed or JobEventStatus.RootSuccessed);
            return (queue.Id, queue.Name, jobs.Length, completed);
        }).ToArray();
    }

    private void OnObservationsChanged(object? sender, EventArgs args)
    {
        if (_disposed || Interlocked.Exchange(ref _refreshPending, 1) != 0) return;
        _ = InvokeAsync(() =>
        {
            Interlocked.Exchange(ref _refreshPending, 0);
            if (_disposed) return;
            Refresh();
            StateHasChanged();
        });
    }

    private void OnJobSelected(Guid jobId) => _selectedJobId = jobId;

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _viewLifetime.Cancel();
        _viewLifetime.Dispose();
        MonitorStore.Changed -= OnObservationsChanged;
    }
}
