@startuml
top to bottom direction
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle

package "TplQueue.Abstractions" <<External>> {
  interface IJobEvent
  interface "IObserver<IJobEvent>" as IJobEventObserver
}

package "TplQueue.Core" {
  class Unsubscriber

  class JobObserverHub {
    +JobObserverHub(logger)
    +Subscribe(observer) : IDisposable
    +Publish(evt, onObserverError) : void
    +PublishError(ex, onObserverError) : void
    +Dispose() : void
  }
}

JobObserverHub o-- "0..*" IJobEventObserver : subscriptions
JobObserverHub ..> IJobEvent : publishes
JobObserverHub ..> Unsubscriber : returns
@enduml
